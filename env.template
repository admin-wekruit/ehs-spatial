# Argus configuration. Copy to .env with make env; validate with make check-env.
# Paths are relative to this checkout or explicit absolute paths. Never commit .env.

# Frozen capture inputs, stage outputs and publications; required by the pipeline.
PANOPTES_DATA_ROOT=./data
# Explicit source for fetch_inputs: file:// mirror, HTTPS mirror, or s3:// blob store. No default remote.
# PANOPTES_INPUT_SOURCE=
# Platform database. Credentials come only from the environment.
PANOPTES_DATABASE_URL=postgresql://panoptes@127.0.0.1:55432/panoptes
# Existing GPU providers run on Modal by default.
GEOMETRY_MVS_BACKEND=modal
SAM3D_BACKEND=modal
# Platform model calls require an explicit paid budget.
PANOPTES_PAID_BUDGET_USD=0

# Blob store override: directory or s3://bucket/prefix; default DATA_ROOT/blobs.
# PANOPTES_BLOB_ROOT=
# Mongo collection prefix when using a Mongo database; default panoptes_.
# PANOPTES_MONGO_PREFIX=
# S3 configuration, only when the blob store uses S3.
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# Platform job execution; default local, or modal with the app/function below.
# PANOPTES_EXECUTOR_BACKEND=
# PANOPTES_MODAL_APP=
# PANOPTES_MODAL_FUNCTION=

# Publication catalog and prepared HTTP overrides; defaults DATA_ROOT/publications/catalog and /http.
# PANOPTES_PUBLICATION_CATALOG=
# PANOPTES_PUBLICATION_HTTP=
# Public report origin, without a trailing slash.
# PANOPTES_PUBLIC_BASE_URL=
# Built viewer override; default this checkout's web/dist.
# PANOPTES_WEB_ROOT=
# Measurement-layer override; default DATA_ROOT/measurement-layer.
# PANOPTES_PAGES=
# Modal publication app and feedback volume names.
# PANOPTES_PUBLICATION_APP=
# PANOPTES_PUBLICATION_FEEDBACK_VOLUME=

# Optional platform/feedback Gemini calls require a model and per-call/total budgets.
# GEMINI_API_KEY=
# PANOPTES_AGENT_MODEL=
# PANOPTES_AGENT_CALL_BUDGET_USD=
# PANOPTES_FEEDBACK_MODEL=
# PANOPTES_FEEDBACK_TOTAL_BUDGET_USD=
# PANOPTES_FEEDBACK_CALL_RESERVATION_USD=
# HTTP provider configuration, only when selecting an existing http backend.
# PANOPTES_SERVICE_API_KEY=
# SAM3D_HTTP_URLS=
# GEOMETRY_MVS_HTTP_URLS=
# PANOPTES_SERVICE_TIMEOUT_S=
# PANOPTES_SERVICE_RETRIES=

# Offline tests load fake models. Do not store HF_TOKEN here.
# PANOPTES_FAKE_MODEL=
# HF_HUB_OFFLINE=
