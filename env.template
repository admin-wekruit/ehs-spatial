# Panoptes: the ONE configuration surface (docs/ENTERPRISE-PLAN-2026-10-07.md §3 rule 4). `make env` copies it to .env, `make check-env` validates it.
# One comment line per key: what it is / default / who reads it. Values are examples for the customer's jump VM 10.21.72.251.
# Loaded by `uv run --env-file .env ...` (pipeline machine) and `docker compose --env-file .env` (GPU machines, `make up`).
# Legacy shell path: `set -a; . ./.env; set +a; source research/module-swap-2026-10-07/env.sh` — env.sh keeps every value set here
# (its defaults are `${VAR:-...}`) and derives the rest. Keys that env.sh derives are COMMENTED OUT below: leave them unset unless you
# need to override (an empty value is NOT "unset" for the Python readers, which use os.environ.get(KEY, default)).
# Never commit .env. Never store HF_TOKEN in it (section 5).

# ======================================================= 1. GPU services (both GPU machines; deploy/compose.gpu-a.yml, compose.gpu-b.yml) =======================================================
# Shared secret: every service checks the X-API-Key header, every client sends it (docs/BACKENDS-v1.md). No default: `openssl rand -hex 32`. Same value on both GPU machines and the pipeline machine. Read by serving/*_service.py, ehs_spatial/providers/service_client.py.
PANOPTES_SERVICE_API_KEY=change-me-openssl-rand-hex-32
# Jobs a service queues before answering 429 busy (the client then backs off and retries). Default 4. Read by serving/*_service.py.
PANOPTES_SERVICE_MAX_QUEUE=4
# Weights directory written ONCE by ehs-spatial/scripts/onprem/fetch_weights_{sam3d,geometry}.py --cache $WEIGHTS (section 5); mounted read-only into every service container and sha256-verified at start. env.sh default: $SWAP_SCRATCH/weights. Read by deploy/compose.gpu-*.yml, env.sh (MODAL_RUN).
WEIGHTS=/srv/panoptes/weights
# Optional s3://bucket/prefix where a service uploads large results and answers with result_uri; unset = results come back inline (result_b64). Needs the section-3 AWS_* keys on the GPU machine. Read by serving/*_service.py.
# PANOPTES_RESULT_BUCKET=s3://panoptes/results
# 1 = services answer with canned results and load no model (CI, laptop smoke, `make smoke` before the weights arrive). Default 0. Read by serving/*_service.py, tests/contract/.
PANOPTES_FAKE_MODEL=0
# manifest (default) = weights from the fetch_weights*.py cache at WEIGHTS, SHA-256 verified against serving/registry.yaml at start; hf-cache = HF_HOME / torch hub already hold them (baked image, pre-mounted cache, a GPU host that already serves the other models) and nothing is linked or verified. Read by serving/sam3d_service.py.
PANOPTES_WEIGHTS_MODE=manifest
# Ports are fixed by serving/registry.yaml, not here: sam3 8801 + sam3d 8805 on card A; mapanything 8802, moge 8803, geometry-mvs 8804 on card B. The jump forwards (deploy/jumpbox/) map onto them.

# ======================================================= 2. Client: model backends (pipeline machine; ehs_spatial/providers/) =======================================================
# SAM 3D Objects: http = the GPU service behind the jump | local = the same function body in this process (ehs-spatial/scripts/onprem/run_stage.py) | modal = our Modal app (rollback). Read by ehs_spatial/providers/sam3d.py.
SAM3D_BACKEND=http
# Comma-separated service roots for sam3d, one per card that runs it; the provider GETs <root>/healthz and sends to the smallest queue_depth. Each root is a JUMP address that socat/nginx forwards to a GPU VM port (deploy/jumpbox/: jump 8085 -> card A 8805; nginx form: https://10.21.72.251:8443/sam3d). Read by ehs_spatial/providers/sam3d.py through service_client.py.
SAM3D_HTTP_URLS=http://10.21.72.251:8085
# GPU half of the licence-clean geometry route (RoMa + DA3-BASE + MoGe-3 depth): http | local | modal. Read by ehs_spatial/providers/geometry_mvs.py.
GEOMETRY_MVS_BACKEND=http
# Service roots for geometry-mvs (jump 8084 -> card B 8804). Read by ehs_spatial/providers/geometry_mvs.py.
GEOMETRY_MVS_HTTP_URLS=http://10.21.72.251:8084
# SAM 3 masks (v0 one-POST contract, docs/BACKENDS.md): http | modal | fal. Code default fal (cloud) — on-prem set http. Read by ehs_spatial/providers/sam3.py.
SAM3_BACKEND=http
# Full endpoint URL of the SAM 3 service (jump 8081 -> card A 8801, path /sam3). Read by ehs_spatial/providers/sam3.py.
SAM3_HTTP_URL=http://10.21.72.251:8081/sam3
# MapAnything geometry (v0 contract): http | modal | replicate. Code default replicate. Read by ehs_spatial/providers/map_anything.py.
GEOMETRY_BACKEND=http
# Full endpoint URL of the MapAnything service (the customer's existing forward: jump 8080 -> 8802, path /geometry). Read by ehs_spatial/providers/map_anything.py.
GEOMETRY_HTTP_URL=http://10.21.72.251:8080/geometry
# MoGe-3 depth (v0 contract): http | modal | replicate. Code default modal. Read by ehs_spatial/providers/moge.py.
MOGE_BACKEND=http
# Full endpoint URL of the MoGe-3 service (the customer's existing forward: jump 8090 -> 8803, path /moge). Read by ehs_spatial/providers/moge.py.
MOGE_HTTP_URL=http://10.21.72.251:8090/moge
# Seconds to wait for one service job (SAM 3D 25 candidates, geometry-mvs all pairs). Default 1800. Read by ehs_spatial/providers/service_client.py.
PANOPTES_SERVICE_TIMEOUT_S=1800
# Retries with exponential backoff on connection errors, 429 and 503 only, never on model_error. Default 3. Read by ehs_spatial/providers/service_client.py.
PANOPTES_SERVICE_RETRIES=3
# Only with the nginx+TLS jump (deploy/jumpbox/compose.nginx.yml) and a private CA: the CA certificate file, under the standard names Python ssl (SSL_CERT_FILE) and requests (REQUESTS_CA_BUNDLE) read. Unset with socat (plain http) or a public CA.
# SSL_CERT_FILE=/etc/panoptes/jump-ca.crt
# REQUESTS_CA_BUNDLE=/etc/panoptes/jump-ca.crt
# Parallel SAM 3 calls from the Gradio workbench app. Default 4. Read by ehs_spatial/providers/sam3.py.
# EHS_SAM_CONCURRENCY=4
# Cloud credentials, read only when a *_BACKEND above is fal / replicate (modal uses `modal token`, not .env). Unset on-prem. Read by fal_client / replicate.
# FAL_KEY=
# REPLICATE_API_TOKEN=
# Gemini VLM for the Gradio workbench app and the report chat; `panoptes run` never calls it. Unset on-prem. Read by ehs_spatial/providers/gemini.py.
# GEMINI_API_KEY=
# Claude (verdict-layer lab only: L4 clause extraction and L5 check synthesis, `panoptes verdict ...`; `panoptes run` never calls it). The
# official SDK resolves credentials itself: this key, or the profile `ant auth login` stores under ~/.config/anthropic/ (then leave it
# unset). Unset on-prem. Read by the anthropic SDK through ehs_spatial/verdict/llm.py.
# ANTHROPIC_API_KEY=
# Claude model of the verdict lab. Default claude-haiku-5-5 (the plan's cheap model). Read by ehs_spatial/verdict/llm.py.
# PANOPTES_VERDICT_MODEL=claude-haiku-5-5
# Directory of the lab's LLM response cache (one JSON per model + prompt; a hit never calls the API). Default runs/llm-cache. Read by ehs_spatial/verdict/llm.py.
# PANOPTES_LLM_CACHE=

# ======================================================= 3. Storage (pipeline machine; platform import/export in S7, `panoptes artifacts push/pull`) =======================================================
# Platform database: postgresql://user:pass@host:5432/db (today) or mongodb://user:pass@host:27017/db (MongoRepository). The URL scheme selects the implementation; the Mongo user may create collections and indexes. Read by ehs-spatial ehs_spatial/platform/config.py + repository.
PANOPTES_DATABASE_URL=postgresql://panoptes@127.0.0.1:55432/panoptes
# Collection-name prefix when PANOPTES_DATABASE_URL is mongodb:// (panoptes_projects, panoptes_jobs, ...). Default panoptes_. Read by ehs-spatial MongoRepository.
PANOPTES_MONGO_PREFIX=panoptes_
# Blob store root: an absolute directory (LocalBlobStore) or s3://bucket/prefix (S3BlobStore, keys = sha256, artifacts under runs/ publications/ layers/ weights/). The scheme selects the implementation. Read by ehs-spatial ehs_spatial/platform/storage.py, scripts/panoptes_artifacts.py.
PANOPTES_BLOB_ROOT=/srv/panoptes/blobs
# S3-compatible endpoint (MinIO, Ceph RGW, ...) for PANOPTES_BLOB_ROOT=s3:// and PANOPTES_RESULT_BUCKET; unset = AWS. Standard boto3 name. Read by boto3 (S3BlobStore, the services).
# AWS_ENDPOINT_URL=https://s3.customer.internal
# S3 credentials under the standard boto3 names; unset when the machine has an instance role. Read by boto3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Region for signature v4; S3-compatible stores accept us-east-1. Default us-east-1. Read by boto3.
AWS_DEFAULT_REGION=us-east-1
# Paid-execution budget of the platform (0 = no paid call ever) — formerly ehs-spatial/.platform/identity-runtime-env.json. Read by ehs-spatial ehs_spatial/platform/config.py.
PANOPTES_PAID_BUDGET_USD=0
# Blender executable for the platform's identity runtime; this pipeline does not use it. Unset = none. Read by ehs-spatial platform runtime.
# PANOPTES_BLENDER_EXECUTABLE=

# ======================================================= 4. Publication hosting (deploy/publications/) =======================================================
# Public origin of the report site (viewer bundle + measurement-layer/ + /api/), no trailing slash: `panoptes run` prints <base>/app.html#/reports/<publicationId>; S3BlobStore.url() builds asset URLs from it. Read by ehs_spatial/cli.py, ehs-spatial storage.py.
PANOPTES_PUBLIC_BASE_URL=http://10.21.72.251:8080
# Exported publications, one directory per publication id (ehs-spatial scripts/export_platform_publication.py; `panoptes artifacts pull publications/<id>` restores one). Read by the publications service (deploy/publications/compose.nginx.yml).
PANOPTES_PUBLICATION_CATALOG=/srv/panoptes/catalog
# Output of ehs-spatial scripts/prepare_publication_site.py (index.json + <sha256>.json.gz bodies), re-prepared after every publish. Read by the publications service.
PANOPTES_PUBLICATION_HTTP=/srv/panoptes/publication-http
# Built viewer bundle (ehs-spatial web/: app.html + assets/, built with VITE_API_ORIGIN= and VITE_PUBLICATION_ID=/), served by nginx. Read by deploy/publications/compose.nginx.yml.
PANOPTES_WEB_ROOT=/srv/panoptes/www
# Measurement layers written by the pipeline (build_swap_layer.py: <publicationId>.json + pipeline-*.jpg), served as /measurement-layer/. env.sh default: $SWAP_SCRATCH/measurement-layer. Read by the notes scripts, deploy/publications/compose.nginx.yml.
PANOPTES_PAGES=/srv/panoptes/www/measurement-layer
# Extra CORS origins of the publication API, comma-separated: only for the S3-static-website option (the bucket's website origin). Unset = same origin behind nginx. Read by the publications service.
# PANOPTES_PUBLICATION_ORIGINS=http://panoptes-reports.s3-website.customer.internal
# Image of the publication service, built once from ehs-spatial/containers/onprem/platform.Dockerfile. Default panoptes-platform:onprem. Read by deploy/publications/compose.nginx.yml.
# PANOPTES_PLATFORM_IMAGE=panoptes-platform:onprem

# ======================================================= 5. Weights fetch: ONCE, on a connected machine, NOT in this file =======================================================
# HF_TOKEN is exported in the shell for the single fetch only (facebook/sam-3d-objects and facebook/sam3 are gated: accept the SAM License on huggingface.co first), then unset. check_env.py refuses a .env that stores it. Or use our weights tar + sha256 manifest and skip the token.
#   export HF_TOKEN=...; python scripts/onprem/fetch_weights_sam3d.py --cache $WEIGHTS; python scripts/onprem/fetch_weights_geometry.py --cache $WEIGHTS; unset HF_TOKEN
# Every process afterwards runs offline. Default 1 (env.sh sets it, the service images set it). Read by huggingface_hub.
HF_HUB_OFFLINE=1

# ======================================================= 6. Pipeline paths (pipeline machine; research/module-swap-2026-10-07/env.sh derives every one left unset) =======================================================
# This checkout (ehs-spatial). env.sh default: the directory of env.sh/../.. Read by env.sh, the notes scripts (swap_generation.py, backbone_ab_modal.py, completion_ab.py).
PANOPTES_SERVING=/srv/panoptes/ehs-spatial
# This repository's checkout (platform + workcell checks + scripts/onprem + serving + pipeline, branch main); the same path as PANOPTES_SERVING.
PANOPTES_WORKCELL=/srv/panoptes/ehs-spatial
# Platform checkout. env.sh default: = $PANOPTES_WORKCELL (one checkout holds both). Read by env.sh, tables_030.py, build_swap_layer.py, serve_export.py.
# PANOPTES_PLATFORM=
# Frozen inputs + every intermediate output (0.5 GB in git; outputs grow next to them). env.sh default: $PANOPTES_SERVING/research/module-swap-2026-10-07/data. Read by env.sh, every notes script, run_all.sh.
# SWAP_SCRATCH=
# Capture runs (lucida-replica-01 = 090, bor1-030-01 = 030). env.sh default: $SWAP_SCRATCH/runs. Read by env.sh, compare.py, swap_generation.py.
# PANOPTES_RUNS=
# Python of this checkout. env.sh default: $PANOPTES_SERVING/.venv/bin/python. Read by env.sh, run_all.sh, Makefile.
# PY=
# How a "modal run APP.py" line is executed; env.sh default = the on-prem runner "$PY $PANOPTES_WORKCELL/scripts/onprem/run_stage.py --weights $WEIGHTS" (= what *_BACKEND=local means). Read by env.sh, run_all.sh, run_stages.py.
# MODAL_RUN=
# Local Postgres 16 that run_all.sh S7 starts when PANOPTES_DATABASE_URL is 127.0.0.1:55432: bin dir / data dir. env.sh defaults: /usr/lib/postgresql/16/bin and $SWAP_SCRATCH/pgdata. Unused with mongodb:// or a managed Postgres. Read by env.sh, run_all.sh.
# PG=/usr/lib/postgresql/16/bin
# PGDATA_DIR=
# Marks on-prem execution (stages drop Modal-only rules such as GPU budget gates). env.sh sets 1. Read by run_stage.py and the Modal apps.
PANOPTES_ONPREM=1

# ======================================================= 7. Tests / CI =======================================================
# Contract tests (tests/contract/) hit this live service root instead of the fake backend when set, e.g. http://10.21.72.251:8085 (needs PANOPTES_SERVICE_API_KEY). Unset in CI. Read by tests/contract/.
# PANOPTES_CONTRACT_URL=
