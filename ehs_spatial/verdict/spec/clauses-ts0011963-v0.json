   "id": "TS0011963:Rev10/9.1.7",
   "standard": "TS-0011963",
   "edition": "Rev 10",
   "title": "Horizontal light curtain no higher than 300 mm",
   "paraphrase": "A detection zone parallel to the floor is mounted at most 300 mm above the floor (ISO 13855:2024 9.2 allows up to 1000 mm with assessment above 200 mm; the customer limit is 300 mm). Applies to a horizontal field only (orientation from the box aspect).",
   "rule_class": "geometry",
   "selection": {
    "H": [
     "light_curtain",
     "area_scanner"
    ]
   },
   "applicability": [
    "horizontal(H)"
   ],
   "requirement": {
    "predicate": "top_height",
    "args": [
     "H"
    ],
    "operator": "<=",
    "threshold": 300,
    "unit": "mm",
    "inputs": []
   },
   "exceptions": [],
   "definitions": [
    "AOPD"
   ],
   "tags": [
    "light_curtain",
    "area_scanner"
