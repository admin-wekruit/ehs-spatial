   "id": "TS0011963:Rev10/9.1.6",
   "standard": "TS-0011963",
   "edition": "Rev 10",
   "title": "Gap between the vertical sensing plane and the horizontal plane's leading edge: at most 70 mm",
   "paraphrase": "The horizontal detection plane starts within 70 mm of the vertical light curtain's sensing plane so nobody fits between them undetected.",
   "rule_class": "geometry",
   "selection": {
    "L": [
     "light_curtain"
    ],
    "H": [
     "light_curtain",
