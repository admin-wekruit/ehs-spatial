  {
   "id": "TS0011963:Rev10/8.1.4",
   "standard": "TS-0011963",
   "edition": "Rev 10",
   "title": "Fixed barrier with operator interaction: minimum height 1000 mm",
   "paraphrase": "Where a person loads or unloads at a fixed barrier, the barrier top is at least 1000 mm above the floor. This is a minimum for the interaction point, not the reach-over control and not climb prevention.",
   "rule_class": "geometry",
   "selection": {
    "F": [
     "fence",
     "guard"
    ]
   },
   "applicability": [
    "perimeter_of(F, Z)",
    "operator_interaction"
   ],
   "requirement": {
    "predicate": "top_height",
    "args": [
     "F"
    ],
    "operator": ">=",
    "threshold": 1000,
    "unit": "mm",
    "inputs": []
   },
   "exceptions": [],
   "definitions": [
    "fixed barrier",
    "operator interaction"
   ],
   "tags": [
    "fence",
    "guard",
    "operator_station"
   ],
   "photo_checkable": true,
   "verified": false,
   "source_url": ""
  },
