     "L",
     "H"
    ],
    "operator": "<=",
    "threshold": 70,
    "unit": "mm",
    "inputs": [],
    "note": "L vertical, H horizontal (attribute orientation)"
   },
   "exceptions": [],
   "definitions": [
    "AOPD"
   ],
   "tags": [
    "light_curtain",
