  {
   "id": "TS0011963:Rev10/9.1.5",
   "standard": "TS-0011963",
   "edition": "Rev 10",
   "title": "Loading area protected by a horizontal AOPD or area scanner",
   "paraphrase": "The space between the vertical light curtain at the loading opening and the hazard is covered by a horizontal light curtain or an area scanner; interrupting either means a person is present.",
   "rule_class": "topology",
   "selection": {
    "L": [
     "light_curtain"
    ],
    "H": [
     "light_curtain",
     "area_scanner"
    ],
    "Z": [
     "hazard_zone",
     "restricted_space"
    ]
   },
   "applicability": [
    "opening(Z, C)",
    "covers_opening(L, C)"
   ],
   "requirement": {
    "predicate": "exists",
    "args": [
     "H"
    ],
    "operator": "exists",
    "unit": "bool",
    "inputs": [],
    "note": "an H with orientation=horizontal whose footprint lies between L and Z"
   },
   "exceptions": [],
   "definitions": [
    "AOPD",
    "area scanner"
   ],
   "tags": [
    "light_curtain",
    "area_scanner",
    "hazard_zone"
   ],
   "photo_checkable": true,
   "verified": false,
   "source_url": ""
  },
