  {
   "id": "ISO13855:2024/Formula13",
   "standard": "ISO 13855",
   "edition": "2024",
   "title": "Vertical light curtain separation distance",
   "paraphrase": "The separation distance of the vertical light curtain follows the approach-speed formula with the stopping time; the concept tool does not compute it because T is unknown.",
   "rule_class": "geometry",
   "selection": {
    "L": [
     "light_curtain"
    ],
    "Z": [
     "hazard_zone",
     "restricted_space"
    ]
   },
   "applicability": [
    "covers_opening(L, C)"
   ],
   "requirement": {
    "predicate": "zone_distance",
    "args": [
     "L",
     "Z"
    ],
    "operator": ">=",
    "formula": "K*T + C",
    "unit": "mm",
    "inputs": [
     "stop_time_ms",
     "resolution_mm",
     "restricted_space"
    ],
    "bindings": {
     "T": "stop_time_ms",
     "d": "resolution_mm"
    }
   },
   "exceptions": [],
   "definitions": [
    "AOPD",
    "hazard zone"
   ],
   "tags": [
    "light_curtain",
    "hazard_zone"
   ],
   "photo_checkable": true,
   "verified": false,
   "source_url": "https://www.iso.org/standard/80590.html"
  },
  {
   "id": "ISO13855:2024/9.3",
   "standard": "ISO 13855",
   "edition": "2024",
   "title": "Horizontal detection zone length: separation distance plus detection depth",
   "paraphrase": "Measured from the edge furthest from the hazard, the horizontal zone length is S = 1600*T + 1200 + Z; the zone is at least 1200 mm deep where a stepping surface of at least 70 mm exists beyond it, at least 900 mm where a structure prevents stepping over undetected.",
   "rule_class": "geometry",
   "selection": {
    "H": [
     "light_curtain",
     "area_scanner"
    ],
    "Z": [
     "hazard_zone",
     "restricted_space"
    ]
   },
   "applicability": [],
   "requirement": {
    "predicate": "zone_distance",
    "args": [
     "H",
     "Z"
    ],
    "operator": ">=",
    "formula": "1600*T + 1200 + Zd",
    "unit": "mm",
    "inputs": [
     "stop_time_ms",
     "zone_depth_mm",
     "restricted_space"
    ],
    "bindings": {
     "T": "stop_time_ms",
     "Zd": "zone_depth_mm"
    }
   },
   "exceptions": [],
   "definitions": [
    "AOPD",
    "hazard zone"
   ],
   "tags": [
    "light_curtain",
    "area_scanner",
    "hazard_zone"
   ],
   "photo_checkable": true,
   "verified": false,
   "source_url": "https://www.iso.org/standard/80590.html"
  },
  {
   "id": "TS0011963:Rev10/10.6.3",
   "standard": "TS-0011963",
   "edition": "Rev 10",
   "title": "Side barriers: ISO 13857 Table 2 reach-over distance plus payload stopping distance",
   "paraphrase": "Side barriers of the robot cell use the ISO 13857:2019 Table 2 high-risk reach-over distance (2200 mm structure: 0 mm up to an 1800 mm hazard point, 400 mm for 2000-2600 mm; no structure below 1400 mm alone; no interpolation) plus a payload stopping distance: 150 mm below 150 kg, 500 mm from 150 to below 300 kg, 700 mm or the manufacturer's worst case from 300 kg.",
   "rule_class": "geometry",
   "selection": {
    "S": [
     "fence",
     "guard",
     "bollard",
     "light_curtain"
    ],
    "H": [
     "robot"
    ]
   },
   "applicability": [
    "perimeter_of(S, Z)"
   ],
   "requirement": {
    "predicate": "reach_over",
    "args": [
     "H",
     "S"
    ],
    "operator": ">=",
    "table": "ISO13857:2019/Table2",
    "unit": "mm",
    "inputs": [
     "table_lookup",
     "risk_level",
     "payload_kg"
    ],
    "note": "c >= Table2(a, b) + ts0011963_table10_3(payload_kg)"
   },
   "exceptions": [],
   "definitions": [
    "protective structure",
    "hazard zone"
   ],
   "tags": [
    "fence",
    "guard",
    "robot"
   ],
   "photo_checkable": true,
   "verified": false,
   "source_url": "https://www.iso.org/standard/69569.html"
  },
