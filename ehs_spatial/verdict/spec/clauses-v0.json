  {
   "id": "ISO13855:2010/normal-approach",
   "standard": "ISO 13855",
   "edition": "2010",
   "title": "Minimum distance of an ESPE, normal approach",
   "paraphrase": "An electro-sensitive protective device whose detection field is approached at right angles must be at least S = K*T + C from the hazard zone: K = 2000 mm/s (S at least 100 mm) or, when that gives more than 500 mm, K = 1600 mm/s (S at least 500 mm); C = 8*(d - 14) mm for detection capability d <= 40 mm and 850 mm for coarser detection. T is the overall stopping performance (machine stop + ESPE response + interface) and is never in a photo. 2010-edition numbers; the 2024 edition rewrites S = K*T + DDS + Z.",
   "rule_class": "geometry",
   "selection": {
    "L": [
     "light_curtain"
    ],
    "Z": [
     "restricted_space",
     "hazard_zone"
    ]
   },
   "applicability": [],
   "requirement": {
    "predicate": "zone_distance",
    "args": [
     "L",
     "Z"
    ],
    "operator": ">=",
    "table": "ISO13855:2010/S",
    "table_args": {
     "stop_time_ms": "stop_time_ms",
     "resolution_mm": "resolution_mm"
    },
    "formula": "S = K*T + C; K = 2000 mm/s if S <= 500 mm else 1600 mm/s; C = 8*(d - 14) if d <= 40 mm else 850; S >= 100 (K = 2000) / 500 (K = 1600)",
    "attributes": [
     "resolution_mm"
    ],
    "unit": "mm",
    "inputs": [
     "stop_time_ms",
     "resolution_mm",
     "restricted_space"
    ]
   },
