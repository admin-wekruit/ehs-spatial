{
  "name": "panoptes-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "node --experimental-strip-types tests/interaction-check.ts && node --experimental-strip-types tests/viewer-scheduling-check.ts",
    "schema": "npx --yes openapi-typescript@7.10.1 http://127.0.0.1:8792/openapi.json -o src/generated/api-schema.ts"
  },
  "dependencies": {
    "@gorules/jdm-editor": "1.52.0",
    "deep-chat": "2.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  }
}
