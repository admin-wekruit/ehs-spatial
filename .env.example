# Copy to .env and fill in. Never commit .env.

# --- provider credentials (cloud mode) ---
GEMINI_API_KEY=          # VLM: orientation / detection / climb review / chat
FAL_KEY=                 # SAM 3 (default backend)
REPLICATE_API_TOKEN=     # MapAnything (default backend)
HF_TOKEN=                # HuggingFace pulls (gated facebook/sam3 for self-hosting)

# --- backend switches (see docs/BACKENDS.md; defaults shown) ---
# SAM3_BACKEND=fal            # fal | modal | http
# GEOMETRY_BACKEND=replicate  # replicate | modal | http
# MOGE_BACKEND=modal          # modal | replicate | http
# SAM3_HTTP_URL=http://<gpu>:8801/sam3
# GEOMETRY_HTTP_URL=http://<gpu>:8802/geometry
# MOGE_HTTP_URL=http://<gpu>:8803/moge

# --- tuning ---
# EHS_SAM_CONCURRENCY=4
